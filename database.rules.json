{
  "rules": {
    "weeks": {
      "$weekStart": {
        "players": {
          ".read": "$weekStart === (now - ((now - 1791255600000) % 604800000)) + ''",
          "$uid": {
            ".write": "auth != null && $weekStart === (now - ((now - 1791255600000) % 604800000)) + '' && ((auth.uid === $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists()))) || (auth.uid === 'Iiu5voyZsiMS4NpFN4mk5GDgfDr1' && data.exists() && !newData.exists()))",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 25 && newData.val().matches(/[A-Za-zÀ-ÖØ-öø-ÿ]/) && newData.val().matches(/^\\S+( \\S+)*$/) && !newData.val().matches(/[<>@\\/#$%&*=+~|^\\\\]/) && !newData.val().matches(/https?:|www[.]|[.](com|br|net|org)/i) && !(' ' + newData.val() + ' ').matches(/[^A-Za-zÀ-ÖØ-öø-ÿ](porra|caralho|merda|fdp|vsf|pqp|buceta|arrombado|puta|puto|cuzão|cuzao|vtnc)[^A-Za-zÀ-ÖØ-öø-ÿ]/i)"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
